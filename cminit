#!/bin/bash

set -e

GITHUB_USERNAME="returntrip"
REPO="bitwarden/sdk-sm"
TEMP_DIR=$(mktemp -d)
OPATH=$PATH
export PATH=$TEMP_DIR:$PATH

# Detect platform and map to the bws asset triple.
# Supported: Linux x86_64, Linux aarch64, macOS Apple Silicon (arm64).
OS="$(uname -s)"
ARCH="$(uname -m)"
case "$OS-$ARCH" in
  Linux-x86_64)         BWS_TRIPLE="x86_64-unknown-linux-gnu" ;;
  Linux-aarch64|Linux-arm64) BWS_TRIPLE="aarch64-unknown-linux-gnu" ;;
  Darwin-arm64)         BWS_TRIPLE="aarch64-apple-darwin" ;;
  *) echo "Unsupported platform: $OS-$ARCH" >&2; exit 1 ;;
esac

# Get BWS TAG
TAG=$(curl -sL https://api.github.com/repos/$REPO/tags | grep -o 'bws-v[^"]*' | sort -un | tail -n 1)
# Get the latest release URL for this platform
RELEASE_ARCHIVE_URL=$(curl -Ls "https://api.github.com/repos/$REPO/releases/tags/$TAG" | grep -Eo 'https://[^"]*' | grep "bws-${BWS_TRIPLE}-")
# Download the release ZIP
curl -sLo "$TEMP_DIR/bws-${BWS_TRIPLE}-latest.zip" "$RELEASE_ARCHIVE_URL"
# Extract the ZIP in the output directory
unzip -q "$TEMP_DIR/bws-${BWS_TRIPLE}-latest.zip" -d "$TEMP_DIR"

# Execute chezmoi and apply the dotfiles to the system
BINDIR="$TEMP_DIR" sh -c "$(curl -fsLS get.chezmoi.io)" -- init --apply "$GITHUB_USERNAME"

export PATH=$OPATH
