{
  "extends": "base-acp",
  "meta": {
    "name": "claude-acp",
    "version": "1.2.1",
    "description": "Claude Code tier: read-only ~/.claude (auth via CLAUDE_CODE_OAUTH_TOKEN, no refresh cycle). Own /tmp/claude-1000 root via CLAUDE_CODE_TMPDIR. Real OAuth token is resolved by nono's proxy from file://~/.config/nono/secrets/claude-oauth and injected as Authorization: Bearer on egress to api.anthropic.com; the agent env only holds nono-phantom-placeholder. Network + filesystem policy live here; settings.json.tmpl supplies repo paths and credential only. Used for both private and public repos - same trust level either way (your subscription, your main model)."
  },
  "groups": {
    "include": [
      "claude_code_linux",
      "claude_cache_linux"
    ]
  },
  "filesystem": {
    "allow": [
      "$HOME/.claude",
      "/tmp/claude-1000",
      "$HOME/.cache/go-build"
    ],
    "read": [
      "/usr/libexec",
      "/usr/include"
    ],
    "read_file": [
      "/etc/gitconfig",
      "/etc/passwd",
      "/etc/group"
    ]
  },
  "network": {
    "allow_domain": [
      "api.anthropic.com",
      "github.com",
      "git.figura.io",
      "go.dev",
      "*.golang.org",
      "*.googleapis.com",
      "dl.google.com"
    ],
    "credentials": ["forgejo", "claude_oauth"],
    "custom_credentials": {
      "forgejo": {
        "upstream": "https://git.figura.io",
        "credential_key": "file://{{ .chezmoi.homeDir }}/.config/nono/secrets/forgejo",
        "env_var": "FORGEJO_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      },
      "claude_oauth": {
        "upstream": "https://api.anthropic.com",
        "credential_key": "file://{{ .chezmoi.homeDir }}/.config/nono/secrets/claude-oauth",
        "env_var": "CLAUDE_CODE_OAUTH_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      }
    }
  }
}
