{
  "extends": "base-acp",
  "meta": {
    "name": "deepseek-acp",
    "version": "2.1.0",
    "description": "DeepSeek tier: extends base-acp only. No access to real $HOME/.claude - session/project state relocated to $HOME/.claude-deepseek via CLAUDE_CONFIG_DIR. Own /tmp/deepseek-tmp root via CLAUDE_CODE_TMPDIR. Real key is resolved by nono's proxy from file://~/.config/nono/secrets/deepseek and injected as Authorization: Bearer on egress to api.deepseek.com; the agent env only ever sees a placeholder (ANTHROPIC_AUTH_TOKEN) and a SHA-256 hash, never the raw key. Network + credential policy now both live here; settings.json.tmpl only supplies the repo path."
  },
  "filesystem": {
    "allow": [
      "$HOME/.claude-deepseek",
      "/tmp/deepseek-tmp"
    ],
    "read": [
      "/usr/libexec",
      "/usr/include"
    ]
  },
  "network": {
    "allow_domain": [
      "api.deepseek.com",
      "github.com",
      "api.github.com",
      "*.githubusercontent.com"
    ],
    "credentials": ["deepseek"],
    "custom_credentials": {
      "deepseek": {
        "upstream": "https://api.deepseek.com",
        "credential_key": "file://{{ .chezmoi.homeDir }}/.config/nono/secrets/deepseek",
        "env_var": "DEEPSEEK_REAL_KEY",
        "inject_mode": "header",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      }
    }
  }
}
