// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
//
// CHEZMOI TEMPLATE: this file is processed by chezmoi. The
// bitwardenSecrets template calls below are resolved at
// `chezmoi apply` time from Bitwarden Secrets Manager (bws) -
// the real key is never committed to git. Requires .accessToken
// set in chezmoi.toml's [data] section.
//
// NOTE: network policy (allow_domain) lives in each nono profile's
// own network.allow_domain field (see .config/nono/profiles/), not
// here. To add a domain for a tier, edit that tier's profile JSON.
//
// Repo layout: /var/home/returntrip/repos/private and
// /var/home/returntrip/repos/public are the two buckets. Anything
// dropped under either is automatically in scope for the matching
// agent entry below - no per-repo config edit needed.
//
// Trust model: Claude handles BOTH buckets (same trust level either
// way - your subscription, your main model). DeepSeek handles ONLY
// the public bucket - never private/internal content.
{
  "cli_default_open_behavior": "existing_window",
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
      "env": {
        "CLAUDE_CODE_EXECUTABLE": "{{ .brew_bin }}/claude",
      },
    },
    "[Claude] (nono)": {
      "type": "custom",
      "command": "flatpak-spawn",
      "args": [
        "--host",
        "--env=PATH={{ .brew_bin }}:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin",
        "--env=CLAUDE_CODE_TMPDIR=/tmp/claude-1000",
        "--env=PRE_COMMIT_HOME=/tmp/claude-1000/pre-commit-cache",
        "--env=CLAUDE_CODE_OAUTH_TOKEN={{ (bitwardenSecrets "91fa7002-b486-4d81-80cc-b47e01545eb6" .accessToken).value }}",
        "--env=FORGEJO_TOKEN={{ (bitwardenSecrets "da40f921-7da0-41e2-9f04-b49000e03a57" .accessToken).value }}",
        "{{ .brew_bin }}/nono",
        "run",
        "--profile", "/var/home/returntrip/.config/nono/profiles/claude-acp.json",
        "--startup-timeout", "0",
        "--allow", "/var/home/returntrip/repos/private",
        "--allow", "/var/home/returntrip/repos/public",
        "--",
        "{{ .brew_bin }}/claude-agent-acp"
      ],
    },
    "[DeepSeek — Public only] (nono)": {
      "type": "custom",
      "default_config_options": {
        "model": "sonnet"
      },
      "command": "flatpak-spawn",
      "args": [
        "--host",
        "--env=PATH={{ .brew_bin }}:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin",
        "--env=ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic",
        "--env=ANTHROPIC_AUTH_TOKEN=nono-phantom-placeholder",
        "--env=DEEPSEEK_REAL_KEY={{ (bitwardenSecrets "a3b58c8d-453b-4d34-a39a-b47e014031af" .accessToken).value }}",
        "--env=CLAUDE_CONFIG_DIR=/var/home/returntrip/.claude-deepseek",
        "--env=CLAUDE_CODE_TMPDIR=/tmp/deepseek-tmp",
        "{{ .brew_bin }}/nono",
        "run",
        "--profile", "/var/home/returntrip/.config/nono/profiles/deepseek-acp.json",
        "--startup-timeout", "0",
        "--allow", "/var/home/returntrip/repos/public",
        "--",
        "{{ .brew_bin }}/claude-agent-acp"
      ],
    },
  },
  "project_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "profiles": {
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "session": {
    "restore_unsaved_buffers": true,
  },
  "autosave": "on_focus_change",
  "ssh_connections": [
    {
      "host": "archdemon.figura.io",
      "username": "returntrip",
      "args": [],
      "projects": [
        {
          "paths": ["/home/returntrip"],
        },
        {
          "paths": ["/home/ubuntu"],
        },
      ],
    },
    {
      "host": "se-container01",
      "args": [],
      "projects": [
        {
          "paths": ["/home/ubuntu"],
        },
        {
          "paths": ["/home/ubuntu/docker/./"],
        },
      ],
    },
  ],
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 18.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
}
