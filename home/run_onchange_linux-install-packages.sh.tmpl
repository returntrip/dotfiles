{{ if or .isLinux .isMacOS -}}
#!/bin/bash
{{ .brew_bin }}/brew bundle --file=/dev/stdin <<EOF
{{ if .isMacOS -}}
{{- range .packages.mac.taps -}}
tap {{ . | quote }}, trusted: true
{{ end -}}
{{- range .packages.mac.brews -}}
brew {{ . | quote }}
{{ end -}}
{{- else }}
{{- range .packages.linux.taps -}}
tap {{ . | quote }}, trusted: true
{{ end -}}
{{- range .packages.linux.brews -}}
brew {{ . | quote }}
{{ end -}}
{{- end }}
{{- if .work }}
{{- range .packages.work.taps -}}
tap {{ . | quote }}, trusted: true
{{ end -}}
{{- range .packages.work.brews -}}
brew {{ . | quote }}
{{ end -}}
{{- end }}
{{ if .isWSL }}
{{ range .packages.wsl.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ end -}}
EOF
{{ end -}}
