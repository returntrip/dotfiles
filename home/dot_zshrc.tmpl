# .zshrc — macOS shell core (installed only on macOS)

# PATH
typeset -U path
path=(~/.local/bin ~/bin $path)

# Homebrew
if [[ -f {{ .brew_bin }}/brew ]]; then
    eval "$({{ .brew_bin }}/brew shellenv)"
fi

# Shell-agnostic aliases, exports, and secrets load (shared with .bash_aliases)
{{ template "shell-common" . }}

## Add an alias, writing to the chezmoi source if we're managed.
addalias() {
    if [[ $# -ne 2 ]]; then
        echo "usage: addalias <name> <value>"
        return 1
    fi
    if type chezmoi &>/dev/null && chezmoi source-path ~/.zshrc &>/dev/null; then
        printf "alias %s='%s'\n" "$1" "$2" >> "$(chezmoi source-path ~/.zshrc)"
        chezmoi apply ~/.zshrc
    else
        printf "alias %s='%s'\n" "$1" "$2" >> ~/.zshrc
    fi
    source ~/.zshrc
}

# mise
if type mise &>/dev/null; then
    eval "$(mise activate zsh)"
fi

# atuin
if type atuin &>/dev/null; then
    eval "$(atuin init zsh)"
fi

# starship
if type starship &>/dev/null; then
    eval "$(starship init zsh)"
fi

# Zellij shell integration (OSC 133) — prompt/command marking for scrollback
if [[ -n "${ZELLIJ:-}" ]]; then
    __zellij_osc133_prompt_start() {
        printf '\033]133;A\007'
    }
    __zellij_osc133_prompt_end() {
        printf '\033]133;B\007'
    }
    __zellij_osc133_command_start() {
        printf '\033]133;C\007'
    }
    __zellij_osc133_command_end() {
        local rc=$?
        printf '\033]133;D;%s\007' "$rc"
        return "$rc"
    }
    autoload -Uz add-zsh-hook
    add-zsh-hook precmd __zellij_osc133_prompt_start
    add-zsh-hook preexec __zellij_osc133_command_start
    PROMPT='$(__zellij_osc133_command_end; __zellij_osc133_prompt_end)$PROMPT'
fi
