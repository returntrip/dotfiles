# .bashrc

{{- if stat (joinPath .chezmoi.homeDir "/.local/share/blesh/ble.sh") }}
# ble.sh
[[ $- == *i* ]] && source ~/.local/share/blesh/ble.sh --noattach
{{- end }}

# Source global definitions
if [ -f /etc/bashrc ]; then
	. /etc/bashrc
fi

# Create pathmunge to avoid path duplications
pathmunge () {
    case ":${PATH}:" in
        *:"$1":*)
            ;;
        *)
            if [ "$2" = "after" ] ; then
                PATH="$PATH":$1
            else
                PATH=$1:"$PATH"
            fi
    esac
}

# User specific environment
if ! [[ "$PATH" =~ "$HOME"/.local/bin ]] ; then
    pathmunge "$HOME"/.local/bin after
fi

if ! [[ "$PATH" =~ "$HOME"/bin ]] ; then
    pathmunge "$HOME"/bin after
fi

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# Add krew kubectl plugin manager to PATH
if [[ -d "$HOME"/.krew/bin ]] ; then
    pathmunge "${KREW_ROOT:-$HOME/.krew}/bin" after 
fi

# Source aliases and functions
if [ -f "$HOME"/.bash_aliases ] ; then
    . "$HOME"/.bash_aliases
fi

# Prevent file overwrite on stdout redirection
# Use `>|` to force redirection to an existing file
set -o noclobber

# Ignore command beginning with space character and duplicated history entries
HISTCONTROL=ignoreboth

# Save multi-line commands as one command
shopt -s cmdhist

# Increase History size
HISTSIZE=500000
HISTFILESIZE=100000

# Use standard ISO 8601 timestamp
# %F equivalent to %Y-%m-%d
# %T equivalent to %H:%M:%S (24-hours format)
HISTTIMEFORMAT='%F %T '

{{- if .isBlueX }}
# User specific environment and startup programs
## To execute flatpaks without needing `flatpak run` including autocomplete
if [[ "$(hostname)" != "toolbox" ]] ; then
    pathmunge /var/lib/flatpak/exports/bin after
fi
{{- end }}

{{- if eq .chezmoi.hostname "rauros" }}

## Devtools paths
if [[ -d "$HOME"/development/android-studio/bin ]] ; then
    pathmunge "$HOME"/development/android-studio/bin after
fi

if [[ -d "$HOME"/development/flutter/bin ]] ; then
    pathmunge "$HOME"/development/flutter/bin after
fi

if [[ -d "$HOME"/development/dart-sdk/bin ]] ; then
    pathmunge "$HOME"/development/dart-sdk/bin after
fi
{{- end }}

{{- if .isLinux }}
{{-   if not .isBlueX }}
if [[ -d {{ .brew_bin | quote }} ]] ; then
    eval "$({{ .brew_bin }}/brew shellenv)"
    #pathmunge {{ .brew_bin }} after
fi
{{-   end }}
{{-  if .isWSL }}
# gpg config with Yubikey
export GPG_TTY="$(tty)"
export SSH_AUTH_SOCK=$(gpgconf --list-dirs agent-ssh-socket)
gpgconf --launch gpg-agent
{{-  end }}
{{- end }}

export PATH
unset -f pathmunge

# CDPATH
CDPATH=/home/{{ .chezmoi.username }}/devel:/home/{{ .chezmoi.username }}/devel/repos
{{- if .personal }}
CDPATH="$CDPATH":/home/{{ .chezmoi.username }}/devel/packaging:/home/{{ .chezmoi.username }}/Nextcloud:/home/{{ .chezmoi.username }}/Nextcloud/Documents
{{- end }}


{{- if .personal }}
# Oracle CLI
[[ -e "{{ .chezmoi.homeDir }}/lib/oracle-cli/lib/python3.10/site-packages/oci_cli/bin/oci_autocomplete.sh" ]] && source "{{ .chezmoi.homeDir }}/lib/oracle-cli/lib/python3.10/site-packages/oci_cli/bin/oci_autocomplete.sh"

{{- end }}

# mise — only for bws/usage; shims PATH instead of activate hook so
# PROMPT_COMMAND stays free (mise's hook would clobber it)
if type mise &>/dev/null; then
    export PATH="$HOME/.local/share/mise/shims:$PATH"
fi

# Set $EDITOR and $PAGER (defaults live in shell-common)
{{- if eq .chezmoi.hostname "rauros" }}
export EDITOR=vim
export VISUAL=vim
{{- end }}

{{- if not .isBlueX }}
# Update window size after every command
shopt -s checkwinsize

# Turn on parallel history
shopt -s histappend

if type brew &>/dev/null; then
  if [[ -r "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh" ]]
  then
    source "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh"
  else
    for COMPLETION in "${HOMEBREW_PREFIX}/etc/bash_completion.d/"*
    do
      [[ -r "${COMPLETION}" ]] && source "${COMPLETION}"
    done
  fi
fi

# starship
if type starship &>/dev/null; then
    eval "$(starship init bash)"
fi
{{- end }}

# atuin
if type atuin &>/dev/null; then
    eval "$(atuin init bash)"
fi
{{- if stat (joinPath .chezmoi.homeDir "/.local/share/blesh/ble.sh") }}
# ble.sh (must be last)
[[ ${BLE_VERSION-} ]] && ble-attach
{{- end }}

# Zellij shell integration (OSC 133) — prompt/command marking for scrollback.
# $ZELLIJ is set only AFTER bashrc sources, so check it at prompt time.
# ble.sh manages the prompt via its own blehook, so register there when
# ble.sh is active; otherwise use PROMPT_COMMAND.
#
# Mark B (command-start) has to be appended to PS1 itself, re-applied every
# cycle, because it must land in the byte stream right after the prompt is
# drawn and before input starts — precmd fires too early (before PS1 draws)
# and preexec fires too late. It's also why this hook must run AFTER
# starship's own precmd (which rewrites PS1 from scratch each time): in the
# non-ble.sh branch that means appending to PROMPT_COMMAND, not prepending.
#
# Under ble.sh, leaving the B mark baked into PS1 makes it echo more than
# once per prompt (ble.sh redraws PS1 for its own layout passes, re-emitting
# whatever's embedded in it). WezTerm's own ble.sh-aware integration works
# around this by restoring PS1 to its unmarked form in preexec (only if
# nothing else already changed it) and re-marking fresh on the next precmd —
# same fix applied here. preexec can also fire more than once per prompt
# (e.g. for commands ble.sh runs internally while composing the prompt), so
# C is guarded to only print once per cycle.
__zellij_osc133_precmd() {
    local rc=$?
    [[ -n "${ZELLIJ:-}" ]] || return
    printf '\033]133;D;%s\007' "$rc"
    printf '\033]133;A\007'
    __zellij_osc133_preexec_fired=
    __zellij_osc133_saved_ps1="$PS1"
    PS1="${PS1}"'\[\033]133;B\007\]'
    __zellij_osc133_marked_ps1="$PS1"
}
__zellij_osc133_preexec() {
    [[ -n "${ZELLIJ:-}" ]] || return
    if [[ -n "${__zellij_osc133_saved_ps1+1}" && "${__zellij_osc133_marked_ps1-}" == "$PS1" ]]; then
        PS1="$__zellij_osc133_saved_ps1"
        unset __zellij_osc133_saved_ps1
    fi
    [[ -z "${__zellij_osc133_preexec_fired:-}" ]] || return
    __zellij_osc133_preexec_fired=1
    printf '\033]133;C\007'
}
if [[ -n "${BLE_VERSION:-}" ]] && declare -F blehook >/dev/null 2>&1; then
    # blehook is a plain function: `blehook NAME+=handler` as one token.
    # blehook/NAME (with a literal slash) is not valid syntax in a sourced
    # script — bash tries to exec it as a path and fails silently at
    # startup ("No such file or directory"), so nothing gets registered.
    blehook PRECMD+=__zellij_osc133_precmd
    blehook PREEXEC+=__zellij_osc133_preexec
else
    PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND; }__zellij_osc133_precmd"
    PS0='\[$(printf "\033]133;C\007")\]'
fi
