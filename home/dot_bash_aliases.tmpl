# User specific aliases and functions loaded by `~/.bashrc`
# ujust alias: https://github.com/ublue-os/config/issues/256#issuecomment-2661130534
{{- if .isBlueX }}
ujust() {
    /usr/bin/just "${@}"
}
{{- end }}

# Shell-agnostic aliases, exports, and secrets load (shared with .zshrc)
{{ template "shell-common" . }}

## Add an alias, writing to the chezmoi source if we're managed.
addalias() {
    if [[ $# -ne 2 ]]; then
        echo "usage: addalias <name> <value>"
        return 1
    fi
    if type chezmoi &>/dev/null && chezmoi source-path ~/.bash_aliases &>/dev/null; then
        printf "alias %s='%s'\n" "$1" "$2" >> "$(chezmoi source-path ~/.bash_aliases)"
    else
        printf "alias %s='%s'\n" "$1" "$2" >> ~/.bash_aliases
    fi
    source ~/.bash_aliases
}

## ssh start $SHELL if tmux not found
ssh () {
    {{- if .isWSL }}
    gpg-connect-agent -q updatestartuptty /bye > /dev/null
    {{- end }}
    export TERM=${TERM:-xterm-256color}
    # Only inject tmux for interactive sessions without -T (no pty) flag
    local inject_tmux=true
    for arg in "$@"; do
        [[ "$arg" == "-T" ]] && inject_tmux=false
    done
    if $inject_tmux && [ $# -eq 1 ] && [[ ! "$1" =~ ^- ]]; then
        command ssh -t "$1" -- 'tmux -u new -A -D -s 0 2>/dev/null || "$SHELL"'
    else
        command ssh "$@"
    fi
}

## PGP Enc/Dec functions
secret () {
        output=~/"${1}".$(date +%s).enc
        gpg --encrypt --armor --output "${output}" -r 0xE8D9210D206385D6 -r stefano@figura.im "${1}" && echo "${1} -> ${output}"
}

reveal () {
        output=$(echo "${1}" | rev | cut -c16- | rev)
        gpg --decrypt --output "${output}" "${1}" && echo "${1} -> ${output}"
}

## Coloured `dmesg`
alias dmesg='dmesg --color=always'

{{- if stat (joinPath .brew_bin "kubecolor") }}
alias kubectl=kubecolor
alias oc="env KUBECTL_COMMAND=oc kubecolor"
{{- end }}

{{- if stat "/usr/bin/terraform" }}
# terraform auto complete
complete -C /usr/bin/terraform terraform
{{- end }}

{{- if eq .chezmoi.hostname "rauros" }}
alias codium='toolbox run --container vscode bash -l -c codium'
{{- end }}
