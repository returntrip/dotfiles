[user]
    email = {{ .email | quote }}
    name = {{ .name | quote }}
    signingkey = 0xE8D9210D206385D6
{{- if or .isWSL .isMacOS }}
[core]
    editor = nvim
{{- end }}
{{ if lookPath "difft" }}
[diff]
    external = difft
{{ end }}
[merge]
    tool = vimdiff
    conflictstyle = diff3
[mergetool]
    prompt = false
    path = nvim
[color]
    ui = auto
[init]
    defaultBranch = main
[url "https://github.com/returntrip/dotfiles.git"]
  insteadOf = "git@github.com:returntrip/dotfiles.git"
# Keep both pushInsteadOf lines. The identity transform below is load-bearing:
# removing it silently breaks `git push` (push falls back to https and fails auth).
[url "git@github.com:"]
  pushInsteadOf = "https://github.com/"
  pushInsteadOf = "git@github.com:"
